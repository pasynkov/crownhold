# Crown Hold - Polygon MCP Server Configuration

# ==============================================
# OPERATION MODE
# ==============================================
# mock - Full mock with simulated data (Phase 1A/1B)
# simulation - Real data + simulated writes (Phase 1C) 🛡️
# production - Real operations (Phase 3+)
OPERATION_MODE=simulation

# ==============================================
# PHASE 1C: READ-ONLY + SIMULATION
# ==============================================

# Polygon Network (mumbai testnet recommended for Phase 1C)
POLYGON_NETWORK=mumbai
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
# Alternative: https://polygon-mumbai.g.alchemy.com/v2/YOUR-KEY

# Wallet Address (PUBLIC ADDRESS ONLY for read-only)
# No private key needed for Phase 1C!
WALLET_ADDRESS=0x...your-public-address

# USDC Contract Address (Mumbai testnet)
USDC_CONTRACT_ADDRESS=0x0FA8781a83E46826621b3BC094Ea2A0212e71B23

# ==============================================
# FUTURE: PRODUCTION CONFIGURATION
# ==============================================

# Mainnet RPC (when ready for production)
# POLYGON_MAINNET_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR-KEY

# Mainnet USDC Contract
# USDC_MAINNET_CONTRACT=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# Private key (ONLY for production mode, NEVER commit!)
# WALLET_PRIVATE_KEY=0x...

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=debug
LOG_FILE=/tmp/crown-polygon.log
LOG_SIMULATIONS=true
SIMULATION_LOG_FILE=/tmp/crown-polygon-simulations.log

# ==============================================
# MOCK CONFIGURATION (for mock mode)
# ==============================================
MOCK_POLYGON_USDC=5234.50
MOCK_POLYGON_MATIC=12.45
MOCK_CONFIRMATION_TIME_MS=2000
