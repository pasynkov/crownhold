# Crown Hold - Wise MCP Server Configuration

# Mode
# Phase 1B: Always mock
ENABLE_MOCK=true

# Mock timing (seconds)
MOCK_TRANSFER_TIME=120

# Logging
LOG_LEVEL=debug
LOG_FILE=/tmp/crown-wise.log

# Mock initial balances
MOCK_WISE_EUR=1500.00
MOCK_WISE_GBP=800.00
MOCK_WISE_USD=250.00

